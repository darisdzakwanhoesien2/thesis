        <script>
            (function () {
                try {
                var loc = window.location;
                var path = (loc.pathname || '').replace(/\/+$/, '');
                var frag = (loc.hash || '').replace(/^#/, '').toLowerCase();

                if (path === '/tentang/profil-perusahaan' && frag === 'sejarah-perusahaan') {
                    loc.replace('/id/about-us/company-history');
                    return;
                }
                } catch (e) {

                }
            })();
        </script>
